ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=postgresql+asyncpg://shotcut:shotcut@localhost:5432/shotcut

# Agent model selection (see shared/models.md for valid IDs)
PLANNER_MODEL=claude-opus-4-7
EXECUTOR_MODEL=claude-opus-4-7
VERIFIER_MODEL=claude-opus-4-7
RESEARCHER_MODEL=claude-haiku-4-5

# Storage root for uploaded/generated workbooks
STORAGE_DIR=./storage

# EDGAR identity (required by SEC; any "Name email" string)
EDGAR_IDENTITY=shotcut-dev dev@example.com

LOG_LEVEL=INFO
